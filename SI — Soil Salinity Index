// ============================================================================
// 1. USER CONFIGURATION (CHANGE STUDY AREA NAME, DATES & EXPORT SETTINGS)
// ============================================================================
var studyAreaName = 'Honnavar';
var mapZoom = 12;
var startDate = '2025-11-01';
var endDate = '2026-04-30';
var maxCloudCover = 10;
var autoQueueExports = true;
var driveFolder = 'GEE_Separate_Indices';
var exportScale = 10;

// ============================================================================
// 2. STUDY AREA RESOLVER & SENTINEL-2 PRE-PROCESSING
// ============================================================================
var namedAreas = {
  'Honnavar': ee.Geometry.Rectangle([74.38, 14.22, 74.52, 14.35]),
  'Uttara Kannada': ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', 'Uttara Kannada')).geometry(),
  'Bannerghatta': ee.Geometry.Rectangle([77.52, 12.72, 77.64, 12.86]),
  'Tumakuru': ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', 'Tumkur')).geometry(),
  'Bidar': ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', 'Bidar')).geometry(),
  'Madikeri': ee.Geometry.Rectangle([75.68, 12.35, 75.85, 12.50]),
  'Ballari': ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', 'Bellary')).geometry(),
  'Koppal': ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', 'Koppal')).geometry()
};
function resolveArea(name) {
  if (namedAreas[name]) return namedAreas[name];
  var g2 = ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2').filter(ee.Filter.eq('ADM2_NAME', name));
  var g1 = ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level1').filter(ee.Filter.eq('ADM1_NAME', name));
  return ee.Geometry(ee.Algorithms.If(g2.size().gt(0), g2.union().geometry(), ee.Geometry(ee.Algorithms.If(g1.size().gt(0), g1.union().geometry(), namedAreas['Honnavar']))));
}
var studyArea = resolveArea(studyAreaName);
Map.centerObject(studyArea, mapZoom);

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(studyArea).filterDate(startDate, endDate)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', maxCloudCover))
  .map(function(img) {
    var scl = img.select('SCL');
    return img.updateMask(scl.eq(4).or(scl.eq(5)).or(scl.eq(6)).or(scl.eq(7))).divide(10000);
  }).median().clip(studyArea);

// ============================================================================
// 3. COMPUTE SI, DISPLAY MAP, SHOW PANEL & EXPORT
// ============================================================================
var indexImg = s2.expression('sqrt(BLUE * RED)', {
  BLUE: s2.select('B2'), RED: s2.select('B4')
}).rename('SI');
var vis = {min: 0.02, max: 0.25, palette: ['#2b83ba', '#abdda4', '#ffffbf', '#fdae61', '#d7191c']};
Map.addLayer(indexImg, vis, 'SI (Salinity) - ' + studyAreaName);
Map.addLayer(ee.FeatureCollection([ee.Feature(studyArea)]).style({color: '00FFFF', fillColor: '00000000', width: 2}), {}, 'Boundary');

var panel = ui.Panel({style: {position: 'top-right', width: '300px', padding: '10px', backgroundColor: 'white'}});
panel.add(ui.Label('08. SI (Soil Salinity Index)', {fontWeight: 'bold', fontSize: '14px'}));
panel.add(ui.Label('Area: ' + studyAreaName + ' | Formula: sqrt(Blue * Red)', {fontSize: '11px'}));
var bar = ui.Panel({layout: ui.Panel.Layout.flow('horizontal')});
vis.palette.forEach(function(c) { bar.add(ui.Label('', {backgroundColor: c, padding: '7px', width: '52px', margin: '1px'})); });
panel.add(bar);
panel.add(ui.Label('Scale: ' + vis.min + ' (Low)  <--->  ' + vis.max + ' (High)', {fontSize: '11px'}));
var statsLbl = ui.Label('Calculating stats...', {fontSize: '11px', whiteSpace: 'pre'});
panel.add(statsLbl);
Map.add(panel);

var st = indexImg.reduceRegion({
  reducer: ee.Reducer.minMax().combine({reducer2: ee.Reducer.mean(), sharedInputs: true}).combine({reducer2: ee.Reducer.stdDev(), sharedInputs: true}),
  geometry: studyArea, scale: 30, maxPixels: 1e13, bestEffort: true
});
ee.Dictionary({s: st, area: studyArea.area().divide(1e6)}).evaluate(function(d) {
  statsLbl.setValue('Area (sq.km): ' + Number(d.area).toFixed(2) + '\nMin: ' + Number(d.s.SI_min).toFixed(4) + ' | Max: ' + Number(d.s.SI_max).toFixed(4) + '\nMean: ' + Number(d.s.SI_mean).toFixed(4) + ' | StdDev: ' + Number(d.s.SI_stdDev).toFixed(4));
});

if (autoQueueExports) {
  Export.image.toDrive({image: indexImg.toFloat(), description: '08_SI_' + studyAreaName.replace(/[^a-zA-Z0-9]/g, '_'), folder: driveFolder, region: studyArea, scale: exportScale, maxPixels: 1e13, fileFormat: 'GeoTIFF'});
}
